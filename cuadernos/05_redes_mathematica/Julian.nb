Cell[BoxData[
 RowBox[{"NewGraph", "=", 
  RowBox[{"Graph", "[", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"SpecialList", "[", 
        RowBox[{"[", 
         RowBox[{"ii", ",", "1"}], "]"}], "]"}], "\[UndirectedEdge]", 
       RowBox[{"SpecialList", "[", 
        RowBox[{"[", 
         RowBox[{"ii", ",", "2"}], "]"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"ii", ",", "1", ",", 
        RowBox[{"Length", "[", "SpecialList", "]"}]}], "}"}]}], "]"}], ",", 
    RowBox[{"VertexLabels", "->", 
     RowBox[{"DeleteDuplicates", "[", 
      RowBox[{"Select", "[", 
       RowBox[{"VrtxLabl", ",", 
        RowBox[{
         RowBox[{"MemberQ", "[", 
          RowBox[{
           RowBox[{"DeleteDuplicates", "[", 
            RowBox[{"Flatten", "[", "SpecialList", "]"}], "]"}], ",", 
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "&"}]}], "]"}], "]"}]}], 
    ",", 
    RowBox[{"VertexShapeFunction", "->", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"ii", "<", 
            RowBox[{"Length", "[", "Hashtags", "]"}]}], ",", 
           RowBox[{"ii", "->", "\"\<Circle\>\""}], ",", 
           RowBox[{"ii", "->", "\"\<Triangle\>\""}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"ii", ",", "1", ",", 
           RowBox[{
            RowBox[{"Length", "[", "Canales", "]"}], "+", 
            RowBox[{"Length", "[", "Hashtags", "]"}]}]}], "}"}]}], "]"}], ",", 
       RowBox[{
        RowBox[{"MemberQ", "[", 
         RowBox[{
          RowBox[{"DeleteDuplicates", "[", 
           RowBox[{"Flatten", "[", "SpecialList", "]"}], "]"}], ",", 
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "&"}]}], "]"}]}], ",", 
    RowBox[{"VertexSize", "->", "0.4"}], ",", 
